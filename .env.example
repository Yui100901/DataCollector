# OpenAI or OpenAI-compatible model configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Also accepted: DATACOLLECTOR_OPENAI_API_KEY, OPENAPI_API_KEY, OPENAPI_KEY
# Also accepted: DATACOLLECTOR_OPENAI_BASE_URL, OPENAI_API_BASE, OPENAPI_BASE_URL, OPENAPI_URL
DATACOLLECTOR_MODEL=gpt-4.1-mini
DATACOLLECTOR_MODEL_API_STYLE=responses
# For many local OpenAI-compatible services, use:
# DATACOLLECTOR_MODEL_API_STYLE=chat_completions

# Runtime defaults
DATACOLLECTOR_HEADLESS=false
DATACOLLECTOR_BROWSER_CHANNEL=
DATACOLLECTOR_BROWSER_EXECUTABLE=
DATACOLLECTOR_MAX_STEPS=12
DATACOLLECTOR_TASK_TIMEOUT=120
DATACOLLECTOR_OUTPUT_DIR=runs
DATACOLLECTOR_DATABASE=
DATACOLLECTOR_ALLOWED_DOMAINS=
DATACOLLECTOR_BLOCKED_DOMAINS=
DATACOLLECTOR_TRACE=true
