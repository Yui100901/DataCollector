# OpenAI model configuration
OPENAI_API_KEY=
DATACOLLECTOR_MODEL=gpt-4.1-mini

# Runtime defaults
DATACOLLECTOR_HEADLESS=false
DATACOLLECTOR_BROWSER_CHANNEL=
DATACOLLECTOR_BROWSER_EXECUTABLE=
DATACOLLECTOR_MAX_STEPS=12
DATACOLLECTOR_TASK_TIMEOUT=120
DATACOLLECTOR_OUTPUT_DIR=runs
DATACOLLECTOR_DATABASE=
DATACOLLECTOR_ALLOWED_DOMAINS=
DATACOLLECTOR_BLOCKED_DOMAINS=
DATACOLLECTOR_TRACE=true
